{
  "name": "directed-3d-printer",
  "version": "1.0.0",
  "description": "3D Printer control interface with real-time layer management",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node --max-old-space-size=4096 --max-http-header-size=16384 server.js",
    "dev": "nodemon --max-old-space-size=4096 --max-http-header-size=16384 server.js",
    "dev:mock": "node --max-old-space-size=4096 --max-http-header-size=16384 server.js",
    "dev:real": "node --max-old-space-size=4096 --max-http-header-size=16384 server.js",
    "install-deps": "npm install",
    "build:exe": "npx @yao-pkg/pkg . --targets node22-win-x64 --output dist/DIRECTED.exe",
    "build:linux": "npx @yao-pkg/pkg . --targets node22-linux-x64 --output dist/DIRECTED-linux",
    "build:linux-arm": "npx @yao-pkg/pkg . --targets node22-linux-arm64 --no-bytecode --public --public-packages \"*\" --output dist/DIRECTED-linux-arm64",
    "build:mac": "npx @yao-pkg/pkg . --targets node22-macos-x64 --output dist/DIRECTED-mac-intel",
    "build:mac-arm": "npx @yao-pkg/pkg . --targets node22-macos-arm64 --no-bytecode --public --public-packages \"*\" --output dist/DIRECTED-mac-apple-silicon",
    "build:all": "npm run build:exe && npm run build:linux && npm run build:linux-arm && npm run build:mac && npm run build:mac-arm",
    "test": "node test/stop-print.test.js",
    "test:rendering": "node --experimental-vm-modules --test test/rendering.test.cjs",
    "benchmark:rendering": "node --experimental-vm-modules test/benchmark-rendering.cjs"
  },
  "pkg": {
    "assets": [
      "index.html",
      "styles.css",
      "splash-screen.css",
      "*.js",
      "lib/**/*",
      "backend/**/*.js",
      "Logo small.svg",
      "Logo+Title.svg",
      "LogoIcon.png",
      "favicon.ico",
      "manifest.json",
      "node_modules/@serialport/bindings-cpp/prebuilds/**/*.node"
    ]
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "serialport": "^12.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.8.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "keywords": [
    "3d-printing",
    "gcode",
    "serial",
    "real-time"
  ],
  "author": "Ido",
  "license": "MIT"
}
